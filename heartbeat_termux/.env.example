# 复制成 .env 再改：cp .env.example .env

# server.py 监听端口
PORT=5000

# Bark 推送 Key（在 Bark App 首页能看到，形如 https://api.day.app/xxxxxxxx，
# 这里只填 xxxxxxxx 那一段）
BARK_KEY=

# 推送图标（可选，留空用 Bark 默认图标）
BARK_ICON=

# 时区
HEARTBEAT_TZ=Asia/Shanghai

# 白天/夜间的时间划分（24小时制整数）：DAY_START_HOUR 到 NIGHT_START_HOUR 算白天
DAY_START_HOUR=10
NIGHT_START_HOUR=0

# 空闲多少分钟以后才允许再次主动唤醒
DAY_INTERVAL_MIN=60
NIGHT_INTERVAL_MIN=120

# 常驻模式（不带 --once 运行时）下，多久检查一次
CHECK_INTERVAL_DAY_SEC=600
CHECK_INTERVAL_NIGHT_SEC=7200

# 心跳时给AI看最近多少条历史消息
CONTEXT_MAX_MESSAGES=40
